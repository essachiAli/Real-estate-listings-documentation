classDiagram
    direction LR

    class User {
        +int id
        +string name
        +string email
        +string password
        +string phone
        +string role
        +login()
        +logout()
    }

    class Admin {
        +approveProperty()
        +rejectProperty()
        +manageUsers()
        +manageCategories()
    }

    class Assistant {
        +createProperty()
        +editProperty()
        +submitForApproval()
    }

    class Category {
        +int id
        +string name
        +string slug
        +string icon
    }

    class Property {
        +int id
        +string title
        +string description
        +decimal price
        +string location
        +int bedrooms
        +int bathrooms
        +int surface
        +string listingType
        +string status
    }

    class PropertyImage {
        +int id
        +string path
        +boolean isPrimary
    }

    class ContactInquiry {
        +int id
        +string visitorName
        +string visitorEmail
        +string message
        +datetime sentAt
    }

    User <|-- Admin                                                                                                                                                                                                                                                         
    User <|-- Assistant                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
    Assistant --> Property                                                                                                                                                                                                                                                 
    Admin --> Property                                                                                                                                                                                                                                                     
    Category --> Property                                                                                                                                                                                                                                                  
    Property --> PropertyImage
    Property --> ContactInquiry